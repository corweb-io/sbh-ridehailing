# Optional concierge WhatsApp (digits with country code, no +).
# If unset, the request sheet still offers the airport and Gustavia taxi stands.
NEXT_PUBLIC_TAXI_WHATSAPP=

# Development convenience only. Keep false in production.
NEXT_PUBLIC_ALLOW_SIMULATED_LOCATION=false

# Server-only key for Google Places API (New). Restrict it to the Places API.
GOOGLE_MAPS_API_KEY=

# Protects /admin, /admin/dispatch, /api/admin/stats, and /api/admin/dispatch
ADMIN_SECRET=replace-with-at-least-24-random-characters

# Server-only driver sign-in. Use independent random values in production.
DRIVER_ACCESS_CODE=
DRIVER_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. If unset, rides and dispatch jobs stay in .data/*.json
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram stand-in for WhatsApp Cloud API (BotFather token).
TELEGRAM_BOT_TOKEN=
# Shared with the local poller and setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (same booker/dispatch as Telegram). Leave empty until WABA is live.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Utility templates (category: UTILITY) so messages still arrive after the 24h
# session. Create each name in WhatsApp Manager in fr and en:
# ride_cancelled: "Course annulée : {{1}}." / "Ride cancelled: {{1}}."
# ride_reminder: "Rappel : {{1}} à {{2}}. Tél. {{3}}." / "Reminder: {{1}} at {{2}}. Guest {{3}}."
# ride_offer: "Nouvelle course : {{1}}. {{2}}. {{3}}." / "New ride: {{1}}. {{2}}. {{3}}."
#   + quick-reply buttons Accepter/Refuser (fr) and Accept/Decline (en).
# ride_assigned: "Taxi confirmé pour {{1}} : {{2}}, tél. {{3}}." / "Taxi confirmed for {{1}}: {{2}}, tel {{3}}."
# ride_unfilled: "Aucun taxi n’a pris {{1}}. Appelez un stand : Aéroport +590 590 52 40 40, Gustavia +590 590 27 66 31."
#   / "No taxi took {{1}}. Call a stand: Airport +590 590 52 40 40, Gustavia +590 590 27 66 31."
# ride_update: "{{1}} : {{2}}"
WHATSAPP_TEMPLATE_CANCEL=ride_cancelled
WHATSAPP_TEMPLATE_REMINDER=ride_reminder
WHATSAPP_TEMPLATE_OFFER=ride_offer
WHATSAPP_TEMPLATE_ASSIGNED=ride_assigned
WHATSAPP_TEMPLATE_UNFILLED=ride_unfilled
WHATSAPP_TEMPLATE_TRIP=ride_update
# Milliseconds per dispatch ring. Default 120000 (2 min). Messages follow this value.
DISPATCH_RING_MS=
# Milliseconds for the booker to confirm a driver accept. Default 60000. Then search continues.
DISPATCH_HOLD_MS=
# Bearer for GET /api/dispatch/tick. Supabase pg_cron calls this every minute.
# After applying migrations, store the public URL and the same secret in Vault:
#   select vault.create_secret('https://<host>/api/dispatch/tick', 'dispatch_tick_url');
#   select vault.create_secret('<CRON_SECRET>', 'dispatch_tick_secret');
CRON_SECRET=
